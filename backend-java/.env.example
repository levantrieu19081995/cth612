SERVER_PORT=8080

# CockroachDB - point to a tested multi-host JDBC URL or a health-checked SQL proxy/gateway.
COCKROACH_JDBC_URL=jdbc:postgresql://127.0.0.1:26257/flight_booking?sslmode=disable
COCKROACH_USERNAME=root
COCKROACH_PASSWORD=

# Cassandra
CASSANDRA_CONTACT_POINTS=127.0.0.1:9042
CASSANDRA_LOCAL_DATACENTER=datacenter1
CASSANDRA_KEYSPACE=flight_booking_events

# CORS
FRONTEND_ORIGIN=http://localhost:3000

# Outbox
OUTBOX_POLL_MS=1000
OUTBOX_BATCH_SIZE=20
